{
  "name": "tecg-cookie-generator",
  "version": "2.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "react-scripts start",
    "build": "tsc ./src/scripts/downloader.ts ./src/types/downloader.d.ts ./src/scripts/build-gh-pages.ts --outDir dist --declaration && node ./dist/scripts/downloader.js",
    "build-step-2": "set \"GENERATE_SOURCEMAP=false\" && react-scripts build",
    "build-step-3": "node ./dist/scripts/build-gh-pages.js",
    "build-step-3-extended": "tsc ./src/scripts/build-gh-pages.ts --outDir dist && node ./dist/scripts/build-gh-pages.js",
    "eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "eslint-fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "package-update": "npm install"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.2",
    "@heroicons/react": "^2.2.0",
    "@popperjs/core": "^2.11.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "@types/gh-pages": "^6.1.0",
    "@types/node": "^24.9.2",
    "@types/node-fetch": "^2.6.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.22.0",
    "@typescript-eslint/parser": "^5.22.0",
    "autoprefixer": "^10.4.21",
    "colorette": "^2.0.20",
    "eslint": "^8.14.0",
    "gh-pages": "^6.3.0",
    "node-fetch": "^2.6.7",
    "tailwindcss": "^3.4.17",
    "typescript": "^4.6.4"
  },
  "optionalDependencies": {
    "@vercel/analytics": "^1.5.0"
  },
  "homepage": "https://boomboompower.github.io/tecg/",
  "keywords": [],
  "author": "boomboompower",
  "license": "MIT",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
