{
  "name": "tecg-cookie-generator",
  "version": "2.0.0",
  "description": "A tool to generate cookies",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx ./src/scripts/downloader.ts",
    "build-step-2": "set \"GENERATE_SOURCEMAP=false\" && vite build",
    "build-step-3": "node ./dist/scripts/build-gh-pages.js",
    "build-step-3-extended": "tsx ./src/scripts/build-gh-pages.ts",
    "eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "eslint-fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "package-update": "npm install"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/vite": "^4.1.17",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/gh-pages": "^6.1.0",
    "@types/node": "^24.10.1",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^5.1.1",
    "colorette": "^2.0.20",
    "eslint": "^9.39.1",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "node-fetch": "^2.7.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.3.2",
    "vite-css-modules": "^1.12.0"
  },
  "optionalDependencies": {
    "@vercel/analytics": "^1.6.1"
  },
  "homepage": "https://boomboompower.github.io/tecg/",
  "keywords": [],
  "author": "boomboompower",
  "license": "MIT",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
